# TWRP Partition Flags - Nubia Z70 Ultra (NX733J)
# Controla qué particiones se muestran en Install/Wipe/Backup
# Formato: <mount_point> <fstype> <flags>
# NO agregar /super — flashearla destruye TODAS las particiones lógicas

# Particiones lógicas (dentro de super) — visibles para instalar ROMs
/system      ext4    backup=1;flash=1;wipe=0;mount=1;
/system_ext  ext4    backup=1;flash=1;wipe=0;mount=1;
/product     ext4    backup=1;flash=1;wipe=0;mount=1;
/vendor      ext4    backup=1;flash=1;wipe=0;mount=1;
/odm         ext4    backup=0;flash=1;wipe=0;mount=1;
/vendor_dlkm ext4    backup=0;flash=0;wipe=0;mount=1;
/odm_dlkm    ext4    backup=0;flash=0;wipe=0;mount=1;
/system_dlkm ext4    backup=0;flash=0;wipe=0;mount=1;

# Boot partitions
/boot        emmc    backup=1;flash=1;wipe=0;mount=0;
/vendor_boot emmc    backup=1;flash=1;wipe=0;mount=0;
/init_boot   emmc    backup=1;flash=1;wipe=0;mount=0;
/dtbo        emmc    backup=1;flash=1;wipe=0;mount=0;
/recovery    emmc    backup=1;flash=0;wipe=0;mount=0;
/vbmeta      emmc    backup=1;flash=1;wipe=0;mount=0;
/vbmeta_system emmc  backup=1;flash=1;wipe=0;mount=0;

# Data
/data        f2fs    backup=1;flash=0;wipe=1;mount=1;storage=1;
/metadata    f2fs    backup=0;flash=0;wipe=1;mount=1;

# Firmware (no tocar)
/persist     ext4    backup=1;flash=0;wipe=0;mount=1;
/firmware    vfat    backup=0;flash=0;wipe=0;mount=0;
/misc        emmc    backup=0;flash=0;wipe=0;mount=0;
/persistent  emmc    backup=0;flash=0;wipe=0;mount=0;

# Super partition — OCULTA para evitar soft brick
/super       raw     backup=0;flash=0;wipe=0;mount=0;
