# system.prop — Nubia Z70 Ultra (NX733J / PQ84A01)
# Android 16 / Snapdragon 8 Elite (sun)

# ADB
ro.adb.secure=0

# A/B & Dynamic Partitions
ro.build.ab_update=true
ro.boot.dynamic_partitions=true

# Battery / Charger
ro.charger.enable_suspend=1

# USB
vendor.usb.configfs=1
vendor.usb.rps_mask=0
vendor.usb.uvc.function.init=1
ro.boot.usbcontroller=a600000.dwc3

# Gatekeeper (descomenta si falla el decrypt en recovery)
# vendor.gatekeeper.disable_spu=true
# vendor.gatekeeper.is_security_level_spu=0

# Platform
ro.board.platform=sun
ro.hardware=qcom

# Product identity
ro.product.brand=nubia
ro.product.device=PQ84A01
ro.product.model=NX733J
ro.product.name=PQ84A01-UN

# Build fingerprint
ro.build.fingerprint=nubia/PQ84A01-UN/PQ84A01:16/BQ2A.250705.001-BP2A.250605.031.A3/20260210.135030:user/release-keys
ro.build.version.security_patch=2026-02-01

# Vendor security patch (vendor está en Android 15)
ro.vendor.build.security_patch=2025-12-01

# Boot device UFS
ro.boot.bootdevice=1d84000.ufshc
ro.boot.boot_devices=soc/1d84000.ufshc

# Display
ro.sf.lcd_density=520

# Crypto / FBE
ro.crypto.state=encrypted
ro.crypto.type=file
ro.crypto.metadata.enabled=true

# Fuse passthrough
persist.sys.fuse.passthrough.enable=true

# Qualcomm
ro.vendor.qti.va_aosp.support=1
ro.vendor.qti.va_odm.support=1